# Docker settings. Copy to .env (the start-lan scripts do this for you and fill in the secrets).
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
POSTGRES_DB=tabulator
POSTGRES_USER=tabulator

# Password for the "Admin" login in the app
ADMIN_PASS=admin

# Port on this computer that judges connect to
APP_PORT=8000

# This computer's LAN IP(s), comma-separated, shown in "Judge access".
# The start-lan scripts detect and fill this in.
HOST_LAN_IP=
